# Frontend — local development (Pattern A: Vite on host, backend in Docker)
#
# 1. Start backend:  cd ../bidmart-infrastructure && docker compose up -d --build
# 2. Copy env:       cp .env.example .env
# 3. Install & run:  npm ci && npm run dev
# 4. Open:           http://localhost:5173

# Leave empty to proxy /api and /ws to gateway via vite.config.ts (http://localhost:8000)
VITE_API_BASE_URL=

# Optional: call gateway directly (no Vite proxy)
# VITE_API_BASE_URL=http://localhost:8000

VITE_GOOGLE_CLIENT_ID=

# Vercel production:
# https://bidmart-frontend.vercel.app
# VITE_API_BASE_URL=https://bidmart-prod.43.157.208.68.sslip.io
# Vercel preview / staging:
# VITE_API_BASE_URL=https://bidmart-staging.43.157.208.68.sslip.io

# Playwright nightly (set in GitHub vars or locally):
# E2E_BASE_URL=https://bidmart-frontend.vercel.app
# E2E_GATEWAY_URL=https://bidmart-staging.43.157.208.68.sslip.io
