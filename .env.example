# Frontend — local development (Pattern A: Vite on host, backend in Docker)
#
# 1. Start backend:  cd ../bidmart-infrastructure && docker compose up -d --build
# 2. Copy env:       cp .env.example .env
# 3. Install & run:  npm ci && npm run dev
# 4. Open:           http://localhost:5173

# Leave empty to proxy /api and /ws to gateway via vite.config.ts (http://localhost:8000)
VITE_API_BASE_URL=

# Optional: call gateway directly (no Vite proxy)
# VITE_API_BASE_URL=http://localhost:8000

VITE_GOOGLE_CLIENT_ID=

# Vercel production:
# https://bidmart-frontend.vercel.app
# Set VITE_API_BASE_URL to the public gateway URL in Vercel env.
