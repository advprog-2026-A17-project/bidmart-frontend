# Frontend — see bidmart-infrastructure/docs/DEPLOYMENT_URLS.md
#
# Local: leave VITE_API_BASE_URL empty (Vite proxies to http://localhost:8000)
#   cd ../bidmart-infrastructure && docker compose up -d
#   npm ci && npm run dev → http://localhost:5173

VITE_API_BASE_URL=

# Staging (Vercel Preview + VPS gateway). Port 8443 because VPS SSH owns 443.
# VITE_API_BASE_URL=https://bidmart-staging.43.157.208.68.sslip.io:8443

# Production (Vercel Production). Port 8443 because VPS SSH owns 443.
# VITE_API_BASE_URL=https://bidmart-prod.43.157.208.68.sslip.io:8443

VITE_GOOGLE_CLIENT_ID=

# Playwright / CI (GitHub repository variables):
# BIDMART_E2E_BASE_URL=https://bidmart-frontend.vercel.app
# BIDMART_E2E_GATEWAY_URL=https://bidmart-staging.43.157.208.68.sslip.io:8443
